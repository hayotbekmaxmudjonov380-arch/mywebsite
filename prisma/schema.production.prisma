generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  telegramId        Int       @unique
  telegramUsername   String?
  telegramFirstName String?
  role              String    @default("user")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  orders            Order[]
  favorites         Favorite[]
  sessions          Session[]

  @@index([telegramId])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String
  longDescription  String
  category         String
  categoryPlatform String
  price            Float
  cover            String
  badges           String
  tags             String
  rating           Float     @default(0)
  reviews          Int       @default(0)
  deliveryTime     String    @default("Instant download")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  licenses         License[]
  orders           Order[]
  favorites        Favorite[]

  @@index([slug])
  @@index([category])
  @@index([categoryPlatform])
  @@index([price])
}

model License {
  id          String    @id @default(cuid())
  name        String
  description String
  price       Float
  features    String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([productId])
}

model Order {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  licenseId     String
  license       License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  amount        Float
  status        String    @default("pending")
  downloadToken String?   @unique
  downloadCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([downloadToken])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  excerpt    String
  coverImage String?
  author     String   @default("ITSHOPPING")
  category   String
  tags       String
  published  Boolean  @default(false)
  views      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([slug])
  @@index([published])
  @@index([category])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([order])
}
