# Database
DATABASE_URL="postgresql://user:password@localhost:5432/itshopping"

# Auth
AUTH_CODE_EXPIRY_MS=120000

# Telegram Bot
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_BOT_USERNAME="your_bot_username"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# AWS S3
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_REGION="eu-central-1"
AWS_S3_BUCKET_NAME="itshopping-files"

# App
NEXT_PUBLIC_SITE_URL="https://itshopping.uz"
NEXT_PUBLIC_API_URL="https://itshopping.uz/api"

# Sentry (optional)
SENTRY_DSN="https://..."
SENTRY_AUTH_TOKEN="your_auth_token"
